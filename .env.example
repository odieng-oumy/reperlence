# =============================================================
# .env.example — Copy this file to .env and fill in your values
# =============================================================

# --- PostgreSQL Database ---
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/repairlens_db

# --- Meta AI API ---
META_API_KEY=your_meta_api_key_here
META_API_URL=https://api.meta.ai/v1
META_VISION_MODEL=muse-spark-1.3
META_TEXT_MODEL=muse-spark-1.3

# --- Groq Fallback (free, for cloud deployment) ---
GROQ_API_KEY=your_groq_api_key_here

# --- Google Sign-In (optional) ---
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com

# --- App ---
APP_NAME=RepairLens
APP_VERSION=1.0.0
DEBUG=False
PORT=8000
